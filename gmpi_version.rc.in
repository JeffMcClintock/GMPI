// Generated by gmpi_plugin() from @GMPI_RC_SOURCE@ - do not edit.
//
// A Windows binary carries no version of its own unless it has a VERSIONINFO
// resource. Without one the Explorer "Details" tab is blank, and two releases
// of the same .vst3 or .gmpi are indistinguishable on disk - which is the whole
// reason this file exists.
//
// The version, product name and company come from the <Plugin> element of the
// plugin's metadata XML, which is the one place a plugin's version is written -
// so what Explorer shows here and what the VST3 factory tells a DAW at runtime
// come from the same attribute of the same element, and an author who bumps it
// has both.
//
// Same attribute, but NOT the same read: CMake cannot call the SDK's XML
// parser, so it locates the element textually (gmpi_find_plugin_element) and
// takes the first one it finds. gmpi::hosting::pluginInfo::version lists the
// cases where that can pick out something other than what loads at runtime -
// and in every one of them the runtime value is the true one and this file is
// the stale one. A mismatch costs a wrong number on a Details tab, never a
// broken build or a plugin a host cannot load.
//
// The internal and original file names are the build's, since they name a file
// rather than a plugin, and the description combines the two.

// The plugin's name and vendor come from XML, which is UTF-8. Without this the
// resource compiler would read them in the build machine's ANSI code page and
// mangle any non-ASCII character.
#pragma code_page(65001)

#include <winver.h>

VS_VERSION_INFO VERSIONINFO
 FILEVERSION    @GMPI_RC_VERSION_QUAD@
 PRODUCTVERSION @GMPI_RC_VERSION_QUAD@
 FILEFLAGSMASK  VS_FFI_FILEFLAGSMASK
#ifdef _DEBUG
 FILEFLAGS      VS_FF_DEBUG
#else
 FILEFLAGS      0x0L
#endif
 FILEOS         VOS_NT_WINDOWS32
 FILETYPE       @GMPI_RC_FILETYPE@
 FILESUBTYPE    VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        // 0409 = US English, 04b0 = 1200 = Unicode. This name must agree with
        // the Translation value at the bottom, or the shell finds no strings
        // and shows the file as having no version information at all.
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      "@GMPI_RC_COMPANY@"
            VALUE "FileDescription",  "@GMPI_RC_DESCRIPTION@"
            VALUE "FileVersion",      "@GMPI_RC_VERSION@"
            VALUE "InternalName",     "@GMPI_RC_INTERNAL_NAME@"
            VALUE "OriginalFilename", "@GMPI_RC_ORIGINAL_FILENAME@"
            VALUE "ProductName",      "@GMPI_RC_PRODUCT@"
            VALUE "ProductVersion",   "@GMPI_RC_VERSION@"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
